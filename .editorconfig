# .editorconfig
# Editor configuration for Python projects
# Based on Python community best practices

# Root configuration
root = true

# ====================================
# General settings - apply to all files
# ====================================

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ====================================
# Python files
# ====================================

[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

# ====================================
# Configuration files
# ====================================

[*.{toml,ini,cfg}]
indent_style = space
indent_size = 2

[*.{json,json5}]
indent_style = space
indent_size = 2

[*.{yaml,yml}]
indent_style = space
indent_size = 2

# ====================================
# Markdown files
# ====================================

[*.{md,markdown}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false  # Trailing spaces may be meaningful in Markdown

# ====================================
# Shell scripts
# ====================================

[*.{sh,bash}]
indent_style = space
indent_size = 2
shell = bash

# ====================================
# Makefile
# ====================================

[Makefile]
indent_style = tab

# ====================================
# Dockerfile
# ====================================

[Dockerfile]
indent_style = space
indent_size = 2

# ====================================
# Git ignore file
# ====================================

[.gitignore]
indent_style = space
indent_size = 2

# ====================================
# Editor config file
# ====================================

[.editorconfig]
indent_style = space
indent_size = 2
